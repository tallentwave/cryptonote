# Copie para .env (ou defina no serviço) e ajuste.
PORT=3000
HOST=0.0.0.0
# Obrigatório em produção: senha do painel /admin
ADMIN_PASSWORD=troque-por-uma-senha-longa
# Nome exibido no certificado (opcional)
ORG_NAME=
# Pasta onde ficam os dados (db.json)
DATA_DIR=./data
# Use 1 quando estiver atrás de Nginx/Apache/Traefik (para limitar tentativas por IP real)
TRUST_PROXY=0
# auto | 1 (sempre Secure). Em HTTPS, "auto" já funciona atrás de proxy com X-Forwarded-Proto
COOKIE_SECURE=auto
